# client_tool/.env — config riêng của client_tool (standalone, KHÔNG cần .env ở
# repo root). Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
# start.bat tự copy sang .env nếu chưa có.

# ── Backend chính (server_gemini_flow.py / backend/main.py, port mặc định 13443) ──
# URL DUY NHẤT client_tool cần biết — mọi thao tác (heartbeat/nhận task/upload kết
# quả, VÀ (2026-07-17) cả CRUD profile/extension/log) đều qua HTTP tới đây.
# client_tool KHÔNG kết nối trực tiếp bất kỳ database nào — chỉ cần đường mạng tới
# URL này (không cần credentials DB, không cần network line-of-sight tới MariaDB).
FLOW_API_URL=https://your-backend-host:14443

# ── Tuỳ chọn — bỏ trống để dùng mặc định trong server/config.py ──
# SELENIUM_PORT=13445
# SELENIUM_PROFILES_DIR=
# CHROMEDRIVER_PATH=
# CHROME_BINARY=
# SELENIUM_POLL_SECS=8
# DEBUG=false
